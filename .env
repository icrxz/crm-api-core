POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=
APP_PROPERTY_FILE=resources/application-dev.properties
PASSWORD_ENV=
HOST_ENV=
JWT_KEY_ENV=
AWS_ACCESS_KEY_ID_ENV=
